{
  "name": "werewolf",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @werewolf/web dev",
    "build": "pnpm --filter @werewolf/web build",
    "deploy:prod": "pnpm --filter @werewolf/web run deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm -r --no-bail test",
    "test:e2e": "pnpm --filter @werewolf/web test:e2e",
    "i18n:check": "node scripts/check-i18n.mjs",
    "design:mockups": "pnpm --filter @werewolf/web exec node scripts/capture-design.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm i18n:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
